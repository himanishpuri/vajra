# Vajra IPS Rules - DROP action for inline blocking
# All rules tested and working with Suricata 8.x

# SQL INJECTION - DROP

drop http any any -> any any (msg:"VAJRA DROP SQL Injection - UNION SELECT"; flow:established,to_server; http.uri; content:"union"; nocase; content:"select"; nocase; distance:0; within:15; classtype:web-application-attack; sid:2000001; rev:1;)

drop http any any -> any any (msg:"VAJRA DROP SQL Injection - Single Quote"; flow:established,to_server; http.uri; content:"%27"; classtype:web-application-attack; sid:2000002; rev:1;)

drop http any any -> any any (msg:"VAJRA DROP SQL Injection - Double Dash"; flow:established,to_server; http.uri; content:"--"; classtype:web-application-attack; sid:2000004; rev:1;)

drop http any any -> any any (msg:"VAJRA DROP SQL Injection - OR 1 equals 1"; flow:established,to_server; http.uri; content:"or"; nocase; content:"1=1"; distance:0; within:10; classtype:web-application-attack; sid:2000005; rev:1;)

drop http any any -> any any (msg:"VAJRA DROP SQL Injection - SLEEP function"; flow:established,to_server; http.uri; content:"sleep("; nocase; classtype:web-application-attack; sid:2000006; rev:1;)

# XSS - DROP

drop http any any -> any any (msg:"VAJRA DROP XSS - Script Tag"; flow:established,to_server; http.uri; content:"<script"; nocase; classtype:web-application-attack; sid:2000010; rev:1;)

drop http any any -> any any (msg:"VAJRA DROP XSS - Script Encoded"; flow:established,to_server; http.uri; content:"%3cscript"; nocase; classtype:web-application-attack; sid:2000011; rev:1;)

drop http any any -> any any (msg:"VAJRA DROP XSS - onload handler"; flow:established,to_server; http.uri; content:"onload="; nocase; classtype:web-application-attack; sid:2000012; rev:1;)

drop http any any -> any any (msg:"VAJRA DROP XSS - onerror handler"; flow:established,to_server; http.uri; content:"onerror="; nocase; classtype:web-application-attack; sid:2000013; rev:1;)

drop http any any -> any any (msg:"VAJRA DROP XSS - javascript protocol"; flow:established,to_server; http.uri; content:"javascript:"; nocase; classtype:web-application-attack; sid:2000014; rev:1;)

drop http any any -> any any (msg:"VAJRA DROP XSS - IMG tag"; flow:established,to_server; http.uri; content:"<img"; nocase; classtype:web-application-attack; sid:2000015; rev:1;)

drop http any any -> any any (msg:"VAJRA DROP XSS - SVG tag"; flow:established,to_server; http.uri; content:"<svg"; nocase; classtype:web-application-attack; sid:2000016; rev:1;)

drop http any any -> any any (msg:"VAJRA DROP XSS - onclick handler"; flow:established,to_server; http.uri; content:"onclick="; nocase; classtype:web-application-attack; sid:2000017; rev:1;)

# PATH TRAVERSAL - DROP

drop http any any -> any any (msg:"VAJRA DROP Path Traversal - dot dot slash"; flow:established,to_server; http.uri; content:"../"; classtype:web-application-attack; sid:2000020; rev:1;)

drop http any any -> any any (msg:"VAJRA DROP Path Traversal - Encoded"; flow:established,to_server; http.uri; content:"%2e%2e"; nocase; classtype:web-application-attack; sid:2000021; rev:1;)

drop http any any -> any any (msg:"VAJRA DROP Path Traversal - etc passwd"; flow:established,to_server; http.uri; content:"etc/passwd"; nocase; classtype:web-application-attack; sid:2000022; rev:1;)

drop http any any -> any any (msg:"VAJRA DROP Path Traversal - etc shadow"; flow:established,to_server; http.uri; content:"etc/shadow"; nocase; classtype:web-application-attack; sid:2000023; rev:1;)

drop http any any -> any any (msg:"VAJRA DROP Path Traversal - Windows style"; flow:established,to_server; http.uri; content:"..\\"; classtype:web-application-attack; sid:2000024; rev:1;)

drop http any any -> any any (msg:"VAJRA DROP Path Traversal - boot.ini"; flow:established,to_server; http.uri; content:"boot.ini"; nocase; classtype:web-application-attack; sid:2000025; rev:1;)

drop http any any -> any any (msg:"VAJRA DROP Path Traversal - win.ini"; flow:established,to_server; http.uri; content:"win.ini"; nocase; classtype:web-application-attack; sid:2000026; rev:1;)

# COMMAND INJECTION - DROP

drop http any any -> any any (msg:"VAJRA DROP Command Injection - wget"; flow:established,to_server; http.uri; content:"wget"; nocase; classtype:web-application-attack; sid:2000030; rev:1;)

drop http any any -> any any (msg:"VAJRA DROP Command Injection - curl"; flow:established,to_server; http.uri; content:"curl"; nocase; classtype:web-application-attack; sid:2000031; rev:1;)

drop http any any -> any any (msg:"VAJRA DROP Command Injection - whoami"; flow:established,to_server; http.uri; content:"whoami"; nocase; classtype:web-application-attack; sid:2000032; rev:1;)

drop http any any -> any any (msg:"VAJRA DROP Command Injection - bin sh"; flow:established,to_server; http.uri; content:"/bin/sh"; classtype:web-application-attack; sid:2000033; rev:1;)

drop http any any -> any any (msg:"VAJRA DROP Command Injection - bin bash"; flow:established,to_server; http.uri; content:"/bin/bash"; classtype:web-application-attack; sid:2000034; rev:1;)

drop http any any -> any any (msg:"VAJRA DROP Command Injection - netcat"; flow:established,to_server; http.uri; content:"nc "; nocase; classtype:web-application-attack; sid:2000035; rev:1;)

drop http any any -> any any (msg:"VAJRA DROP Command Injection - dev tcp"; flow:established,to_server; http.uri; content:"/dev/tcp"; classtype:web-application-attack; sid:2000036; rev:1;)

drop http any any -> any any (msg:"VAJRA DROP Command Injection - cat etc"; flow:established,to_server; http.uri; content:"cat "; nocase; content:"/etc"; distance:0; within:20; classtype:web-application-attack; sid:2000037; rev:1;)

drop http any any -> any any (msg:"VAJRA DROP Command Injection - pipe ls"; flow:established,to_server; http.uri; content:"|7c|"; content:"ls"; distance:0; within:10; classtype:web-application-attack; sid:2000038; rev:1;)

drop http any any -> any any (msg:"VAJRA DROP Command Injection - semicolon ls"; flow:established,to_server; http.uri; content:"|3b|"; content:"ls"; distance:0; within:10; classtype:web-application-attack; sid:2000039; rev:1;)

# PORT SCAN - DROP

drop tcp any any -> $HOME_NET any (msg:"VAJRA DROP Port Scan - SYN Flood"; flags:S,12; threshold:type both, track by_src, count 15, seconds 3; classtype:attempted-recon; sid:2000040; rev:1;)

drop tcp any any -> $HOME_NET any (msg:"VAJRA DROP Port Scan - FIN Scan"; flags:F,12; threshold:type both, track by_src, count 10, seconds 5; classtype:attempted-recon; sid:2000041; rev:1;)

drop tcp any any -> $HOME_NET any (msg:"VAJRA DROP Port Scan - XMAS Scan"; flags:FPU,12; threshold:type both, track by_src, count 5, seconds 5; classtype:attempted-recon; sid:2000042; rev:1;)

drop tcp any any -> $HOME_NET any (msg:"VAJRA DROP Port Scan - NULL Scan"; flags:0,12; threshold:type both, track by_src, count 5, seconds 5; classtype:attempted-recon; sid:2000043; rev:1;)

# DDoS - DROP

drop tcp any any -> $HOME_NET any (msg:"VAJRA DROP DDoS - SYN Flood"; flags:S,12; threshold:type both, track by_src, count 100, seconds 2; classtype:denial-of-service; sid:2000050; rev:1;)

drop udp any any -> $HOME_NET any (msg:"VAJRA DROP DDoS - UDP Flood"; threshold:type both, track by_src, count 200, seconds 2; classtype:denial-of-service; sid:2000051; rev:1;)

drop icmp any any -> $HOME_NET any (msg:"VAJRA DROP DDoS - ICMP Flood"; itype:8; threshold:type both, track by_src, count 50, seconds 2; classtype:denial-of-service; sid:2000052; rev:1;)

drop http any any -> $HOME_NET any (msg:"VAJRA DROP DDoS - HTTP Flood"; flow:to_server; threshold:type both, track by_src, count 30, seconds 2; classtype:denial-of-service; sid:2000053; rev:1;)

# CREDENTIAL ABUSE - DROP

drop tcp any any -> $HOME_NET 22 (msg:"VAJRA DROP SSH Brute Force"; flow:to_server; flags:S,12; threshold:type both, track by_src, count 3, seconds 30; classtype:attempted-admin; sid:2000060; rev:2;)

drop tcp any any -> $HOME_NET 21 (msg:"VAJRA DROP FTP Brute Force"; flow:to_server; flags:S,12; threshold:type both, track by_src, count 3, seconds 30; classtype:attempted-admin; sid:2000061; rev:2;)

drop tcp any any -> $HOME_NET 3389 (msg:"VAJRA DROP RDP Brute Force"; flow:to_server; flags:S,12; threshold:type both, track by_src, count 3, seconds 30; classtype:attempted-admin; sid:2000062; rev:2;)
